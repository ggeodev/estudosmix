# Copie para .env (ou use Configurações > IA dentro do app). NUNCA compartilhe este arquivo.
GEMINI_API_KEY=
# Modelo para tutor, explicações e questões (econômico). Confira nomes atuais em ai.google.dev
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo para converter PDFs em questões (fidelidade importa mais aqui)
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
